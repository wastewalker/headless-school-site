# Where Strapi is running. Read on the server only.
STRAPI_URL=http://localhost:1337

# Optional read-only Strapi API token. Public read works without one.
STRAPI_TOKEN=

# Shared with Strapi's FRONTEND_REVALIDATE_SECRET so saves in the CMS refresh the site.
REVALIDATE_SECRET=change-me

# Fallback refresh, in seconds, in case a revalidation call is missed.
CMS_REVALIDATE_SECONDS=300

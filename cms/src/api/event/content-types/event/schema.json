{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Dated events on the school calendar."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "startsAt": {
      "type": "datetime",
      "required": true
    },
    "endsAt": {
      "type": "datetime"
    },
    "location": {
      "type": "string",
      "required": true
    },
    "levels": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::level.level",
      "inversedBy": "events"
    }
  }
}
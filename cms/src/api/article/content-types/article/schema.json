{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "News stories."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    "body": {
      "type": "blocks",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "school-life",
        "academics",
        "sports",
        "community"
      ],
      "required": true,
      "default": "school-life"
    },
    "levels": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::level.level",
      "inversedBy": "articles"
    }
  }
}